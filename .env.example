# Credenciais OAuth2 do App Dropbox (fluxo de refresh token, sem expiracao).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Token do Hugging Face com acesso aos modelos pyannote/speaker-diarization-3.1
# e pyannote/segmentation-3.0 (aceitar os termos de uso de cada um no site).
HF_TOKEN=

# Diretorio base para arquivos temporarios e estado (default: ~/.voxelfc)
VOXELFC_HOME=

# Compatibilidade legada durante a migracao:
# SUPERTRANSCRIPTFC_HOME=
