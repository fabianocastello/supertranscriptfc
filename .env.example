# Token de acesso do App Dropbox (Settings > OAuth 2 > Generated access token,
# ou um refresh token de longa duracao se o app estiver em modo "scoped").
DROPBOX_ACCESS_TOKEN=

# Token do Hugging Face com acesso aos modelos pyannote/speaker-diarization-3.1
# e pyannote/segmentation-3.0 (aceitar os termos de uso de cada um no site).
HF_TOKEN=

# Diretorio base para arquivos temporarios e estado (default: ~/.supertranscriptfc)
SUPERTRANSCRIPTFC_HOME=
