# Dropbox App OAuth2 credentials (refresh token flow, no expiration).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Hugging Face token with access to the pyannote/speaker-diarization-3.1
# and pyannote/segmentation-3.0 models (accept each one's terms of use on the site).
HF_TOKEN=

# Base directory for temporary files and state (default: ~/.voxelfc)
VOXELFC_HOME=

# Legacy compatibility during migration:
# SUPERTRANSCRIPTFC_HOME=
